<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="description" content="Karl Shop - Website giới thiệu sản phẩm và đặt hàng">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>@ViewData["Title"] - Karl Shop</title>

    <link rel="icon" href="~/client/img/core-img/favicon.ico">

    <!-- Core Style CSS: da import san bootstrap, font-awesome, themify, owl, animate -->
    <link rel="stylesheet" href="~/client/css/core-style.css">
    <link rel="stylesheet" href="~/client/style.css">
    <!-- Responsive CSS -->
    <link rel="stylesheet" href="~/client/css/responsive.css">
</head>

<body>
    <!-- Side menu: danh muc san pham -->
    <div class="catagories-side-menu">
        <div id="sideMenuClose">
            <i class="ti-close"></i>
        </div>
        <div class="nav-side-menu">
            <div class="menu-list">
                <h6>Danh mục</h6>
                @await Component.InvokeAsync("CategoryMenu", new { menuId = "menu-content" })
            </div>
        </div>
    </div>

    <div id="wrapper">

        <partial name="_Header" />

        <section class="top-discount-area d-md-flex align-items-center">
            <div class="single-discount-area">
                <h5>Miễn phí vận chuyển &amp; đổi trả</h5>
                <h6><a asp-controller="Shop" asp-action="Index">MUA NGAY</a></h6>
            </div>
            <div class="single-discount-area">
                <h5>Thanh toán khi nhận hàng (COD)</h5>
                <h6>AN TÂM MUA SẮM</h6>
            </div>
            <div class="single-discount-area">
                <h5>Hàng mới về mỗi tuần</h5>
                <h6>THEO DÕI CỬA HÀNG</h6>
            </div>
        </section>

        @if (TempData["Success"] != null || TempData["Error"] != null)
        {
            <div class="container mt-3">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Đóng"><span aria-hidden="true">&times;</span></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Đóng"><span aria-hidden="true">&times;</span></button>
                    </div>
                }
            </div>
        }

        @RenderBody()

        <partial name="_Footer" />
    </div>

    <script src="~/client/js/jquery/jquery-2.2.4.min.js"></script>
    <script src="~/client/js/popper.min.js"></script>
    <script src="~/client/js/bootstrap.min.js"></script>
    <script src="~/client/js/plugins.js"></script>
    <script src="~/client/js/active.js"></script>
    <!-- Validate phia client (can Internet; khong co Internet thi server van validate) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/client/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>