                    <div class="footer-logo">
                        <img src="~/client/img/core-img/logo.png" alt="Karl Shop">
                    </div>
                    <div class="copywrite_text d-flex align-items-center">
                        <p>
                            Copyright &copy;@DateTime.Now.Year Karl Shop. Giao diện: <i class="fa fa-heart-o" aria-hidden="true"></i> Karl template by <a href="https://colorlib.com" target="_blank">Colorlib</a>
