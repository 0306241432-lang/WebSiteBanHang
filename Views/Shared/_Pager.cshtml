@using Microsoft.AspNetCore.Http
@model IPagedList
@{
    string PageUrl(int p)
    {
        var query = Context.Request.Query
            .Where(kv => !string.Equals(kv.Key, "page", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(kv => kv.Key, kv => kv.Value.ToString());
        query["page"] = p.ToString();
        return Context.Request.Path.Value + QueryString.Create(query).ToUriComponent();
    }
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
}
@if (Model.TotalPages > 1)
{
    <nav aria-label="Phân trang">
        <ul class="pagination justify-content-center mt-5">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link" href="@PageUrl(Model.Page - 1)">&laquo;</a>
            </li>
            @if (start > 1)
            {
                <li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
                if (start > 2)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
            }
            @for (var i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="@PageUrl(i)">@i</a></li>
            }
            @if (end < Model.TotalPages)
            {
                if (end < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                <li class="page-item"><a class="page-link" href="@PageUrl(Model.TotalPages)">@Model.TotalPages</a></li>
            }
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@PageUrl(Model.Page + 1)">&raquo;</a>
            </li>
        </ul>
    </nav>
}