@model CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<!-- ****** Cart Area Start ****** -->
<div class="cart_area section_padding_100 clearfix">
    <div class="container">
        @if (Model.IsEmpty)
        {
            <div class="row">
                <div class="col-12 text-center">
                    <h4>Giỏ hàng của bạn đang trống</h4>
                    <p class="mt-3">Hãy chọn vài sản phẩm yêu thích nhé!</p>
                    <a asp-controller="Shop" asp-action="Index" class="btn karl-btn mt-30">Tiếp tục mua sắm</a>
                </div>
            </div>
        }
        else
        {
            <form asp-controller="Cart" asp-action="UpdateAll" method="post">
                @* Nút mặc định (ẩn): khi nhấn Enter trong ô số lượng sẽ "Cập nhật", không bị nhầm sang nút "Xóa" của dòng đầu *@
                <button type="submit" tabindex="-1" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;"></button>
                <div class="row">
                    <div class="col-12">
                        <div class="cart-table clearfix">
                            <table class="table table-responsive">
                                <thead>
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th>Đơn giá</th>
                                        <th>Số lượng</th>
                                        <th>Thành tiền</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Model.Lines.Count; i++)
                                    {
                                        var line = Model.Lines[i];
                                        <tr>
                                            <td class="cart_product_img d-flex align-items-center">
                                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@line.ProductId"><img src="@Url.Content(ViewHelpers.ImagePath(line.ImageUrl))" alt="@line.Name"></a>
                                                <h6>@line.Name</h6>
                                            </td>
                                            <td class="price"><span>@line.Price.ToVnd()</span></td>
                                            <td class="qty">
                                                <div class="quantity">
                                                    <input type="hidden" name="items[@i].ProductId" value="@line.ProductId" />
                                                    <span class="qty-minus"><i class="fa fa-minus" aria-hidden="true"></i></span>
                                                    <input type="number" class="qty-text" step="1" min="1" max="99" name="items[@i].Quantity" value="@line.Quantity">
                                                    <span class="qty-plus"><i class="fa fa-plus" aria-hidden="true"></i></span>
                                                </div>
                                            </td>
                                            <td class="total_price"><span>@line.LineTotal.ToVnd()</span></td>
                                            <td>
                                                <button type="submit" class="btn-remove-line" title="Xóa sản phẩm"
                                                        formaction="@Url.Action("Remove", "Cart")" name="productId" value="@line.ProductId">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="cart-footer d-flex mt-30">
                            <div class="back-to-shop w-50">
                                <a asp-controller="Shop" asp-action="Index">Tiếp tục mua sắm</a>
                            </div>
                            <div class="update-checkout w-50 text-right">
                                <button type="submit" class="link-button" formaction="@Url.Action("Clear", "Cart")">Xóa giỏ hàng</button>
                                <button type="submit" class="link-button">Cập nhật giỏ hàng</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>

            <div class="row justify-content-end">
                <div class="col-12 col-lg-5">
                    <div class="cart-total-area mt-70">
                        <div class="cart-page-heading">
                            <h5>Tổng giỏ hàng</h5>
                            <p>Thông tin thanh toán</p>
                        </div>
                        <ul class="cart-total-chart">
                            <li><span>Tạm tính</span> <span>@Model.Total.ToVnd()</span></li>
                            <li><span>Phí vận chuyển</span> <span>Miễn phí</span></li>
                            <li><span><strong>Tổng cộng</strong></span> <span><strong>@Model.Total.ToVnd()</strong></span></li>
                        </ul>
                        <a asp-controller="Checkout" asp-action="Index" class="btn karl-checkout-btn">Tiến hành đặt hàng</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<!-- ****** Cart Area End ****** -->
