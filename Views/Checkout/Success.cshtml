@model Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<section class="section_padding_100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="text-center mb-5">
                    <i class="fa fa-check-circle" style="font-size: 72px; color: #28a745;"></i>
                    <h2 class="mt-3">Đặt hàng thành công!</h2>
                    <p class="mt-2">Cảm ơn <strong>@Model.CustomerName</strong>. Mã đơn hàng của bạn là <strong>#@Model.Id</strong>.<br />Chúng tôi sẽ liên hệ qua số <strong>@Model.Phone</strong> để xác nhận đơn.</p>
                </div>

                <div class="order-details-confirmation">
                    <div class="cart-page-heading">
                        <h5>Chi tiết đơn hàng #@Model.Id</h5>
                        <p>Giao tới: @Model.Address</p>
                    </div>
                    <ul class="order-details-form mb-4">
                        <li><span>Sản phẩm</span> <span>Thành tiền</span></li>
                        @foreach (var d in Model.Details)
                        {
                            <li><span>@d.ProductName × @d.Quantity</span> <span>@d.LineTotal.ToVnd()</span></li>
                        }
                        <li><span>Phí vận chuyển</span> <span>Miễn phí</span></li>
                        <li><span>Tổng cộng</span> <span>@Model.TotalAmount.ToVnd()</span></li>
                    </ul>
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <p><strong>Ghi chú:</strong> @Model.Note</p>
                    }
                </div>

                <div class="text-center mt-5">
                    <a asp-controller="Shop" asp-action="Index" class="btn karl-btn">Tiếp tục mua sắm</a>
                </div>
            </div>
        </div>
    </div>
</section>
