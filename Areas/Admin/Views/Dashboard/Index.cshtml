@model List<Order>
@{
    ViewData["Title"] = "Tổng quan";
    var cards = new[]
    {
        new { Css = "panel-primary", Icon = "fa-sitemap", Value = ((int)ViewBag.CategoryCount).ToString(), Label = "Danh mục", Ctrl = "Categories", Link = "Quản lý danh mục" },
        new { Css = "panel-green", Icon = "fa-tags", Value = ((int)ViewBag.ProductCount).ToString(), Label = "Sản phẩm", Ctrl = "Products", Link = "Quản lý sản phẩm" },
        new { Css = "panel-yellow", Icon = "fa-shopping-cart", Value = ((int)ViewBag.OrderCount).ToString(), Label = "Đơn hàng (" + (int)ViewBag.PendingCount + " chờ xử lý)", Ctrl = "Orders", Link = "Quản lý đơn hàng" },
        new { Css = "panel-red", Icon = "fa-money", Value = ((decimal)ViewBag.Revenue).ToVnd(), Label = "Doanh thu (đơn hoàn thành)", Ctrl = "Orders", Link = "Xem đơn hàng" }
    };
}

<div class="row">
    @foreach (var c in cards)
    {
        <div class="col-lg-3 col-md-6">
            <div class="panel @c.Css">
                <div class="panel-heading">
                    <div class="row">
                        <div class="col-xs-3"><i class="fa @c.Icon fa-5x"></i></div>
                        <div class="col-xs-9 text-right">
                            <div class="huge" style="font-size:@(c.Value.Length > 6 ? "24px" : "40px")">@c.Value</div>
                            <div>@c.Label</div>
                        </div>
                    </div>
                </div>
                <a asp-controller="@c.Ctrl" asp-action="Index">
                    <div class="panel-footer">
                        <span class="pull-left">@c.Link</span>
                        <span class="pull-right"><i class="fa fa-arrow-circle-right"></i></span>
                        <div class="clearfix"></div>
                    </div>
                </a>
            </div>
        </div>
    }
</div>

<div class="panel panel-default">
    <div class="panel-heading">Đơn hàng mới nhất</div>
    <div class="panel-body">
        @if (!Model.Any())
        {
            <p class="text-muted">Chưa có đơn hàng nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr><th>Mã</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td>#@o.Id</td>
                                <td>@o.CustomerName</td>
                                <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@o.TotalAmount.ToVnd()</td>
                                <td><span class="label @o.Status.BadgeClass()">@o.Status.GetDisplayName()</span></td>
                                <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-xs btn-primary">Chi tiết</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>