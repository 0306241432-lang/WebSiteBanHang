@model List<Category>
@{
    ViewData["Title"] = "Danh mục sản phẩm";
}

<p><a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> Thêm danh mục</a></p>

<div class="panel panel-default">
    <div class="panel-body">
        @if (!Model.Any())
        {
            <p class="text-muted">Chưa có danh mục nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th style="width:60px">#</th>
                            <th>Tên danh mục</th>
                            <th>Mô tả</th>
                            <th style="width:110px">Số sản phẩm</th>
                            <th style="width:170px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>@c.Id</td>
                                <td>@c.Name</td>
                                <td>@c.Description</td>
                                <td>@c.Products.Count</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-xs btn-warning"><i class="fa fa-pencil"></i> Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-xs btn-danger"><i class="fa fa-trash-o"></i> Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
