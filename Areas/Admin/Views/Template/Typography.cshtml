@{
    ViewData["Title"] = "Typography";
}

<div class="row">
    <div class="col-lg-6">
        <div class="panel panel-default">
            <div class="panel-heading">Headings</div>
            <div class="panel-body">
                <h1>h1. Bootstrap heading <small>Secondary text</small></h1>
                <h2>h2. Bootstrap heading <small>Secondary text</small></h2>
                <h3>h3. Bootstrap heading <small>Secondary text</small></h3>
                <h4>h4. Bootstrap heading <small>Secondary text</small></h4>
                <h5>h5. Bootstrap heading <small>Secondary text</small></h5>
                <h6>h6. Bootstrap heading <small>Secondary text</small></h6>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">Body Copy</div>
            <div class="panel-body">
                <p class="lead">Đoạn văn nổi bật (lead). Dùng để giới thiệu nội dung chính của trang.</p>
                <p>Đoạn văn bình thường. Có thể dùng <strong>chữ đậm</strong>, <em>chữ nghiêng</em>, <mark>chữ đánh dấu</mark>, <del>chữ gạch ngang</del> và <u>chữ gạch chân</u>.</p>
                <p><small>Đây là chữ nhỏ (small).</small></p>
                <p class="text-left">Căn trái.</p>
                <p class="text-center">Căn giữa.</p>
                <p class="text-right">Căn phải.</p>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="panel panel-default">
            <div class="panel-heading">Emphasis Classes</div>
            <div class="panel-body">
                <p class="text-muted">Chữ mờ (text-muted)</p>
                <p class="text-primary">Chữ màu chính (text-primary)</p>
                <p class="text-success">Chữ thành công (text-success)</p>
                <p class="text-info">Chữ thông tin (text-info)</p>
                <p class="text-warning">Chữ cảnh báo (text-warning)</p>
                <p class="text-danger">Chữ nguy hiểm (text-danger)</p>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">Lists, Blockquote and Code</div>
            <div class="panel-body">
                <ul>
                    <li>Mục danh sách 1</li>
                    <li>Mục danh sách 2
                        <ul><li>Mục con</li></ul>
                    </li>
                </ul>
                <ol>
                    <li>Bước một</li>
                    <li>Bước hai</li>
                </ol>
                <blockquote>
                    <p>Một câu trích dẫn.</p>
                    <footer>Nguồn trích dẫn</footer>
                </blockquote>
                <p>Mã nội dòng: <code>dotnet run</code></p>
                <pre>var total = price * quantity;</pre>
            </div>
        </div>
    </div>
</div>