@{
    ViewData["Title"] = "Panels and Wells";
}

<div class="row">
    <div class="col-lg-4">
        <div class="panel panel-default">
            <div class="panel-heading">Default Panel</div>
            <div class="panel-body"><p>Nội dung của panel mặc định.</p></div>
            <div class="panel-footer">Panel Footer</div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel panel-primary">
            <div class="panel-heading">Primary Panel</div>
            <div class="panel-body"><p>Nội dung của panel primary.</p></div>
            <div class="panel-footer">Panel Footer</div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel panel-success">
            <div class="panel-heading">Success Panel</div>
            <div class="panel-body"><p>Nội dung của panel success.</p></div>
            <div class="panel-footer">Panel Footer</div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <div class="panel panel-info">
            <div class="panel-heading">Info Panel</div>
            <div class="panel-body"><p>Nội dung của panel info.</p></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel panel-warning">
            <div class="panel-heading">Warning Panel</div>
            <div class="panel-body"><p>Nội dung của panel warning.</p></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel panel-danger">
            <div class="panel-heading">Danger Panel</div>
            <div class="panel-body"><p>Nội dung của panel danger.</p></div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="panel panel-default">
            <div class="panel-heading">Collapsible Accordion Panel Group</div>
            <div class="panel-body">
                <div class="panel-group" id="accordion">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h4 class="panel-title"><a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">Collapsible Group Item #1</a></h4>
                        </div>
                        <div id="collapseOne" class="panel-collapse collapse in">
                            <div class="panel-body">Nội dung của mục thứ nhất.</div>
                        </div>
                    </div>
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h4 class="panel-title"><a data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">Collapsible Group Item #2</a></h4>
                        </div>
                        <div id="collapseTwo" class="panel-collapse collapse">
                            <div class="panel-body">Nội dung của mục thứ hai.</div>
                        </div>
                    </div>
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h4 class="panel-title"><a data-toggle="collapse" data-parent="#accordion" href="#collapseThree">Collapsible Group Item #3</a></h4>
                        </div>
                        <div id="collapseThree" class="panel-collapse collapse">
                            <div class="panel-body">Nội dung của mục thứ ba.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <h3>Wells</h3>
        <div class="well">
            <h4>Normal Well</h4>
            <p>Khung chứa nội dung nổi bật dạng lõm.</p>
        </div>
        <div class="well well-lg">
            <h4>Large Well</h4>
            <p>Well kích thước lớn.</p>
        </div>
        <div class="well well-sm">
            <h4>Small Well</h4>
            <p>Well kích thước nhỏ.</p>
        </div>
    </div>
</div>