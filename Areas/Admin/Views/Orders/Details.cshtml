@model Order
@{
    ViewData["Title"] = "Đơn hàng #" + Model.Id;
    var next = Model.NextStatuses().ToList();
}

<p><a asp-action="Index" class="btn btn-default"><i class="fa fa-arrow-left"></i> Danh sách đơn hàng</a></p>

<div class="row">
    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">Thông tin khách hàng</div>
            <div class="panel-body">
                <dl class="dl-horizontal">
                    <dt>Họ tên</dt><dd>@Model.CustomerName</dd>
                    <dt>Điện thoại</dt><dd>@Model.Phone</dd>
                    <dt>Địa chỉ</dt><dd>@Model.Address</dd>
                    <dt>Ghi chú</dt><dd>@(string.IsNullOrWhiteSpace(Model.Note) ? "—" : Model.Note)</dd>
                    <dt>Ngày đặt</dt><dd>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">Trạng thái đơn hàng</div>
            <div class="panel-body">
                <p>Hiện tại: <span class="label @Model.Status.BadgeClass()" style="font-size:100%">@Model.Status.GetDisplayName()</span></p>

                @if (next.Any())
                {
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="form-inline">
                        <div class="form-group">
                            <label for="status">Chuyển sang:</label>
                            <select name="status" id="status" class="form-control">
                                @foreach (var s in next)
                                {
                                    <option value="@((int)s)">@s.GetDisplayName()</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary">Cập nhật</button>
                    </form>
                }
                else
                {
                    <p class="text-muted">Đơn hàng đã kết thúc, không thể thay đổi trạng thái.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">Sản phẩm trong đơn</div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-right">Đơn giá</th>
                        <th class="text-right">Số lượng</th>
                        <th class="text-right">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Details)
                    {
                        <tr>
                            <td>@d.ProductName @if (d.ProductId == null) { <small class="text-muted">(sản phẩm đã bị xóa)</small> }</td>
                            <td class="text-right">@d.UnitPrice.ToVnd()</td>
                            <td class="text-right">@d.Quantity</td>
                            <td class="text-right">@d.LineTotal.ToVnd()</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-right">Tổng cộng</th>
                        <th class="text-right">@Model.TotalAmount.ToVnd()</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
