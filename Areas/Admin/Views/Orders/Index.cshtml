@model PagedList<Order>
@{
    ViewData["Title"] = "Đơn hàng";
    OrderStatus? current = ViewBag.Status;
    string q = ViewBag.Q;
}

<div class="row" style="margin-bottom:15px">
    <div class="col-sm-8">
        <ul class="nav nav-pills">
            <li class="@(current == null ? "active" : "")"><a asp-action="Index">Tất cả</a></li>
            @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
            {
                <li class="@(current == s ? "active" : "")"><a asp-action="Index" asp-route-status="@((int)s)">@s.GetDisplayName()</a></li>
            }
        </ul>
    </div>
    <div class="col-sm-4">
        <form asp-action="Index" method="get" class="form-inline text-right">
            @if (current.HasValue)
            {
                <input type="hidden" name="status" value="@((int)current.Value)" />
            }
            <input type="text" name="q" value="@q" class="form-control" placeholder="Mã đơn, tên, số điện thoại..." />
            <button type="submit" class="btn btn-default"><i class="fa fa-search"></i></button>
        </form>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-body">
        @if (!Model.Items.Any())
        {
            <p class="text-muted">Không có đơn hàng nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Điện thoại</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th style="width:100px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Items)
                        {
                            <tr>
                                <td>#@o.Id</td>
                                <td>@o.CustomerName</td>
                                <td>@o.Phone</td>
                                <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@o.TotalAmount.ToVnd()</td>
                                <td><span class="label @o.Status.BadgeClass()">@o.Status.GetDisplayName()</span></td>
                                <td><a asp-action="Details" asp-route-id="@o.Id" class="btn btn-xs btn-primary"><i class="fa fa-eye"></i> Chi tiết</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_AdminPager" model="Model" />
        }
    </div>
</div>