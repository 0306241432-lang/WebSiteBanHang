@model Product
@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="row">
    <div class="col-md-8">
        <div class="panel panel-danger">
            <div class="panel-heading">Xác nhận xóa sản phẩm</div>
            <div class="panel-body">
                <div class="media">
                    <img class="pull-left preview-img" style="margin-right:15px" src="@Url.Content(ViewHelpers.ImagePath(Model.ImageUrl))" alt="@Model.Name" />
                    <div class="media-body">
                        <h4>@Model.Name</h4>
                        <p>Danh mục: @Model.Category?.Name</p>
                        <p>Giá bán: @Model.Price.ToVnd()</p>
                    </div>
                </div>
                <hr />
                <p>Bạn có chắc muốn xóa sản phẩm này? Các đơn hàng cũ vẫn giữ lại thông tin sản phẩm đã mua.</p>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-danger"><i class="fa fa-trash-o"></i> Xóa</button>
                    <a asp-action="Index" class="btn btn-default">Hủy</a>
                </form>
            </div>
        </div>
    </div>
</div>
