@model PagedList<Product>
@{
    ViewData["Title"] = "Sản phẩm";
    string q = ViewBag.Q;
}

<div class="row" style="margin-bottom:15px">
    <div class="col-sm-3">
        <a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> Thêm sản phẩm</a>
    </div>
    <div class="col-sm-9">
        <form asp-action="Index" method="get" class="form-inline text-right">
            <input type="text" name="q" value="@q" class="form-control" placeholder="Tìm theo tên sản phẩm..." />
            <select name="categoryId" asp-items="(SelectList)ViewBag.Categories" class="form-control">
                <option value="">Tất cả danh mục</option>
            </select>
            <button type="submit" class="btn btn-default"><i class="fa fa-search"></i> Tìm</button>
            <a asp-action="Index" class="btn btn-link">Xóa lọc</a>
        </form>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-body">
        @if (!Model.Items.Any())
        {
            <p class="text-muted">Không có sản phẩm nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th style="width:60px">#</th>
                            <th style="width:80px">Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Danh mục</th>
                            <th>Giá bán</th>
                            <th style="width:130px">Ngày tạo</th>
                            <th style="width:200px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Items)
                        {
                            <tr>
                                <td>@p.Id</td>
                                <td><img class="thumb-sm" src="@Url.Content(ViewHelpers.ImagePath(p.ImageUrl))" alt="@p.Name" /></td>
                                <td>@p.Name</td>
                                <td>@p.Category?.Name</td>
                                <td>@p.Price.ToVnd()</td>
                                <td>@p.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-xs btn-info"><i class="fa fa-eye"></i> Xem</a>
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-xs btn-warning"><i class="fa fa-pencil"></i> Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-xs btn-danger"><i class="fa fa-trash-o"></i> Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_AdminPager" model="Model" />
        }
    </div>
</div>